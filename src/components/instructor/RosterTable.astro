---
import type { RosterStudent } from '@lib/instructor/class-roster';
import { WEEKLY_CELL_SYMBOL } from '@lib/attendance-weekly';

interface Props {
  students: RosterStudent[];
  /** week_of Mondays for the per-week attendance columns. */
  weeks: string[];
  lessonsTotal: number;
  course: string;
  semester: string;
  usesSections: boolean;
  canManage: boolean;
  instructorId: string;
  instructorOptions: Array<{ id: string; label: string }>;
}

const {
  students,
  weeks,
  lessonsTotal,
  course,
  semester,
  usesSections,
  canManage,
  instructorId,
  instructorOptions,
} = Astro.props;
const SECTION_OPTS = ['CML', 'CTL', 'CWL', 'CRL'];

function pct(v: number | null): string {
  return v == null ? '—' : `${Math.round(v * 100)}%`;
}

function lastSeen(iso: string | null): string {
  if (!iso) return 'never';
  const days = Math.floor((Date.now() - Date.parse(iso)) / 86_400_000);
  if (days <= 0) return 'today';
  if (days === 1) return '1d ago';
  return `${days}d ago`;
}
---

<div class="mt-4 overflow-x-auto rounded-lg border border-slate-200">
  <table class="w-full text-sm">
    <thead
      class="bg-slate-50 text-left text-xs uppercase tracking-wide text-ink-muted"
    >
      <tr>
        <th class="px-3 py-2 font-medium">Student</th>
        {usesSections && <th class="px-3 py-2 font-medium">Section</th>}
        <th class="px-3 py-2 font-medium">Lessons</th>
        <th class="px-3 py-2 font-medium">Quizzes</th>
        <th class="px-3 py-2 font-medium">Avg</th>
        <th class="px-3 py-2 font-medium">Attend</th>
        {
          weeks.map((w) => (
            <th
              class="px-2 py-2 text-center font-medium whitespace-nowrap"
              title={`Week of ${w}`}
            >
              {w.slice(5).replace('-', '/')}
            </th>
          ))
        }
        <th class="px-3 py-2 font-medium">Last seen</th>
        <th class="px-3 py-2 font-medium">Flag</th>
        {canManage && <th class="px-3 py-2 font-medium">Manage</th>}
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      {
        students.map((s) => (
          <tr class={s.risk.atRisk ? 'bg-amber-50/60' : ''}>
            <td class="px-3 py-2">
              <div class="font-medium">
                {s.name ?? (
                  <span class="italic text-ink-muted">(no name set)</span>
                )}
              </div>
              <div class="text-xs text-ink-muted">{s.email ?? '—'}</div>
            </td>
            {usesSections && (
              <td class="px-3 py-2">
                {s.section ? (
                  s.section
                ) : (
                  <span class="font-medium text-amber-800">Not assigned</span>
                )}
              </td>
            )}
            <td class="px-3 py-2 tabular-nums">
              {s.lessonsCompleted}/{lessonsTotal}
            </td>
            <td class="px-3 py-2 tabular-nums">{s.quizzesTaken}</td>
            <td class="px-3 py-2 tabular-nums">{pct(s.avgBestScore)}</td>
            <td class="px-3 py-2 tabular-nums">{s.attendanceCount}</td>
            {s.weeklyCells.map((cell) => (
              <td
                class={`px-2 py-2 text-center ${
                  cell === 'attended'
                    ? 'text-emerald-600'
                    : cell === 'missed'
                      ? 'text-rose-600'
                      : 'text-slate-400'
                }`}
                title={cell}
              >
                {WEEKLY_CELL_SYMBOL[cell]}
              </td>
            ))}
            <td class="px-3 py-2 whitespace-nowrap text-ink-muted">
              {lastSeen(s.lastActiveAt)}
            </td>
            <td class="px-3 py-2">
              {s.risk.atRisk ? (
                <details>
                  <summary class="cursor-pointer rounded bg-amber-100 px-2 py-0.5 text-xs font-semibold uppercase text-amber-800">
                    ⚠ at-risk
                  </summary>
                  <ul class="mt-1 min-w-48 list-disc space-y-1 pl-4 text-xs text-amber-900">
                    {s.risk.reasons.map((reason) => (
                      <li>{reason}</li>
                    ))}
                  </ul>
                </details>
              ) : (
                <span class="text-ink-muted">—</span>
              )}
            </td>
            {canManage && (
              <td class="px-3 py-2">
                <details>
                  <summary class="cursor-pointer text-xs text-accent">
                    Edit {s.name ?? s.email ?? 'student'}
                  </summary>
                  <form
                    method="POST"
                    action="/api/instructor/classes/update"
                    class="mt-2 flex flex-col gap-1"
                  >
                    <input type="hidden" name="course_slug" value={course} />
                    <input type="hidden" name="semester" value={semester} />
                    <input
                      type="hidden"
                      name="instructor_id"
                      value={instructorId}
                    />
                    <input type="hidden" name="user_id" value={s.userId} />
                    <input
                      name="student_name"
                      placeholder="Display name"
                      aria-label={`Display name for ${s.name ?? s.email ?? 'student'}`}
                      value={s.name ?? ''}
                      class="rounded border border-slate-300 px-1 py-0.5 text-xs"
                    />
                    {usesSections && (
                      <select
                        name="section"
                        aria-label={`Section for ${s.name ?? s.email ?? 'student'}`}
                        class="rounded border border-slate-300 px-1 py-0.5 text-xs"
                      >
                        <option value="" selected={!s.section}>
                          —
                        </option>
                        {SECTION_OPTS.map((o) => (
                          <option value={o} selected={s.section === o}>
                            {o}
                          </option>
                        ))}
                      </select>
                    )}
                    {instructorOptions.length > 1 && (
                      <select
                        name="new_instructor_id"
                        aria-label={`Transfer ${s.name ?? s.email ?? 'student'} to instructor`}
                        class="rounded border border-slate-300 px-1 py-0.5 text-xs"
                      >
                        {instructorOptions.map((option) => (
                          <option
                            value={option.id}
                            selected={option.id === instructorId}
                          >
                            {option.label}
                          </option>
                        ))}
                      </select>
                    )}
                    <button
                      type="submit"
                      class="rounded bg-accent px-2 py-0.5 text-xs text-white"
                    >
                      Save
                    </button>
                  </form>
                  <form
                    method="POST"
                    action="/api/instructor/classes/drop"
                    class="mt-2"
                    onsubmit="return confirm('Remove this student from the class?');"
                  >
                    <input type="hidden" name="course_slug" value={course} />
                    <input type="hidden" name="semester" value={semester} />
                    <input
                      type="hidden"
                      name="instructor_id"
                      value={instructorId}
                    />
                    <input type="hidden" name="user_id" value={s.userId} />
                    <button
                      type="submit"
                      class="text-xs text-red-600 underline"
                    >
                      Remove
                    </button>
                  </form>
                </details>
              </td>
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

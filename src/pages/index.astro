---
import BaseLayout from '@layouts/BaseLayout.astro';
import TypingVerb from '@components/hero/TypingVerb.astro';
import { getCollection } from 'astro:content';

const allLessons = (await getCollection('lessons', (l) => !l.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const courses = [
  {
    slug: 'fin-3610',
    code: 'FIN 3610',
    title: 'Corporate Finance',
    blurb:
      'Upper-division: TVM, valuation, risk/return, capital structure, options.',
    href: '/fin-3610',
  },
];

const stats = courses.map((c) => ({
  ...c,
  count: allLessons.filter((l) => l.data.course === c.slug).length,
}));
---

<BaseLayout>
  <section class="bg-brand">
    <div class="mx-auto max-w-4xl px-4 py-20 text-center">
      <h1
        class="break-words text-4xl font-extrabold tracking-tight text-white md:text-5xl"
      >
        Economics &amp; Finance you can{' '}
        <TypingVerb
          verbs={[
            'play with',
            'explore',
            'tinker with',
            'simulate',
            'visualize',
          ]}
        />.
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-brand-mist">
        Interactive lessons, calibrated visualizations, and short quizzes
        designed for undergraduate econ and finance courses. Drag a slider,
        watch the curves move, then test yourself.
      </p>
      <div
        class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row"
      >
        <a
          href="/fin-3610"
          class="rounded-lg bg-white px-5 py-3 text-left text-brand shadow-sm transition hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-sky sm:min-w-[18rem]"
        >
          <span class="block text-xs uppercase tracking-wide opacity-80">
            Start with FIN 3610:
          </span>
          <span class="mt-0.5 block text-lg font-semibold leading-snug">
            Corporate Finance
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-16">
    <h2 class="text-2xl font-semibold">Course</h2>
    <ul class="mt-6 grid grid-cols-1 gap-4">
      {
        stats.map((c) => (
          <li class="break-words rounded-lg border border-slate-200 bg-white hover:border-accent transition">
            <a href={c.href} class="block h-full rounded-lg p-5">
              <p class="text-xs uppercase tracking-wide text-accent font-medium">
                {c.code}
              </p>
              <h3 class="mt-1 text-lg font-semibold">{c.title}</h3>
              <p class="mt-1 text-sm text-ink-muted">{c.blurb}</p>
              <p class="mt-3 text-xs text-ink-muted">{c.count} lessons</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

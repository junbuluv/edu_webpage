---
// Rendered on request, not prerendered, so the header shows who is signed in
// and pages that find no item can hand off to it. On Vercel this also sends
// every address with no page to the server function, with status 404.
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <div class="mx-auto max-w-xl px-4 py-16">
    <h1 class="text-2xl font-semibold">Page not found</h1>
    <p class="mt-3 max-w-measure text-ink-muted">
      There is no page at this address. The link may be old, or the address may
      be mistyped.
    </p>
    <ul class="mt-6 space-y-2">
      <li><a class="text-accent underline" href="/">Home page</a></li>
      <li>
        <a class="text-accent underline" href="/fin-3610"
          >FIN 3610: Corporate Finance</a
        >
      </li>
      <li>
        <a class="text-accent underline" href="/practice">Practice quizzes</a>
      </li>
    </ul>
  </div>
</BaseLayout>

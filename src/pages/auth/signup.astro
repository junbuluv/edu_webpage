---
import BaseLayout from '@layouts/BaseLayout.astro';
import {
  ALLOWED_EMAIL_DOMAINS,
  allowedDomainsHumanList,
} from '@lib/auth/email-allowlist';
import { isSignupRole } from '@lib/auth/signup-role';

const next = Astro.url.searchParams.get('next') ?? '/';
const error = Astro.url.searchParams.get('error');

// Preserve the chosen role across a validation bounce so the student doesn't
// have to re-pick it just to fix a mistyped ID.
const roleParam = Astro.url.searchParams.get('role') ?? 'student';
const selectedRole = isSignupRole(roleParam) ? roleParam : 'student';

const ROLE_CHOICES: Array<{ value: string; label: string; hint: string }> = [
  { value: 'student', label: 'Student', hint: 'Enrolled in a course' },
  {
    value: 'instructor',
    label: 'Lecturer',
    hint: 'Teaching a course (needs approval)',
  },
  {
    value: 'ta',
    label: 'Teaching assistant',
    hint: 'Supporting a course (needs approval)',
  },
];

// HTML5 pattern: any local-part, then @, then exactly one of our allowed
// domains. Browser-side check only; server-side is the source of truth.
const emailPattern = `^[^@\\s]+@(${ALLOWED_EMAIL_DOMAINS.map((d) =>
  d.replace(/\./g, '\\.'),
).join('|')})$`;
const allowedList = allowedDomainsHumanList();
Astro.response.headers.set('Cache-Control', 'no-store');
---

<BaseLayout title="Create account">
  <div class="mx-auto max-w-md px-4 py-16">
    <h1 class="text-2xl font-semibold mb-2">Create account</h1>
    <p class="text-ink-muted mb-2">
      For Baruch College students, faculty, and staff.
    </p>
    <p class="text-sm text-ink-muted mb-6">
      Use your Baruch email. If the confirmation email doesn't arrive (CUNY's
      spam filter sometimes blocks it), you can sign up with a personal Gmail
      instead. Accepted: <strong>{allowedList}</strong>.
    </p>

    {
      error && (
        <div
          role="alert"
          class="mb-4 rounded border border-red-300 bg-red-50 p-3 text-sm text-red-800"
        >
          {error}
        </div>
      )
    }

    <form method="POST" action="/api/auth/signup" class="space-y-4">
      <input type="hidden" name="next" value={next} />

      <fieldset>
        <legend class="text-sm font-medium">I am a</legend>
        <div class="mt-2 space-y-2">
          {
            ROLE_CHOICES.map((choice) => (
              <label class="flex items-start gap-2 rounded border border-slate-300 px-3 py-2">
                <input
                  type="radio"
                  name="role"
                  value={choice.value}
                  checked={selectedRole === choice.value}
                  required
                  class="mt-1 js-role"
                />
                <span>
                  <span class="text-sm font-medium">{choice.label}</span>
                  <span class="block text-xs text-ink-muted">
                    {choice.hint}
                  </span>
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div id="student-id-field">
        <label class="block">
          <span class="text-sm font-medium">Student ID (EMPLID)</span>
          <input
            name="student_id"
            inputmode="numeric"
            autocomplete="off"
            placeholder="15113468"
            class="mt-1 w-full rounded border border-slate-300 px-3 py-2"
          />
          <span class="mt-1 block text-xs text-ink-muted">
            The 8-digit ID from CUNYfirst. Your instructor uses it to match you
            to the class roster.
          </span>
        </label>
      </div>

      <p
        id="staff-note"
        hidden
        class="rounded border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900"
      >
        Lecturer and teaching-assistant accounts are reviewed by an
        administrator. You can sign in right away, but staff features stay
        locked until your request is approved.
      </p>

      <label class="block">
        <span class="text-sm font-medium">Email</span>
        <input
          name="email"
          type="email"
          required
          autocomplete="email"
          pattern={emailPattern}
          title={`Must be one of: ${allowedList}.`}
          placeholder="firstname.lastname@baruchmail.cuny.edu"
          class="mt-1 w-full rounded border border-slate-300 px-3 py-2"
        />
      </label>
      <label class="flex items-start gap-2 text-sm text-ink-muted">
        <input
          name="accept_terms"
          type="checkbox"
          value="yes"
          required
          class="mt-1"
        />
        <span>
          I accept the <a class="text-accent underline" href="/terms"
            >Terms of Service</a
          >
          {' '}and acknowledge the{' '}
          <a class="text-accent underline" href="/privacy">Privacy Policy</a>.
        </span>
      </label>
      <label class="block">
        <span class="text-sm font-medium">Password</span>
        <input
          name="password"
          type="password"
          required
          minlength="8"
          autocomplete="new-password"
          class="mt-1 w-full rounded border border-slate-300 px-3 py-2"
        />
        <span class="mt-1 block text-xs text-ink-muted">
          At least 8 characters.
        </span>
      </label>
      <button
        type="submit"
        class="w-full rounded bg-accent px-4 py-2 font-medium text-white hover:bg-blue-700"
      >
        Create account
      </button>
    </form>

    <p class="mt-6 text-sm text-ink-muted">
      Already have one?
      <a
        class="text-accent underline"
        href={`/auth/signin?next=${encodeURIComponent(next)}`}>Sign in</a
      >
    </p>
  </div>
</BaseLayout>

<script>
  // Progressive enhancement only: without JS the student-ID field stays
  // visible and simply isn't required, and the server re-validates either
  // way (it ignores a student ID sent with a staff role).
  const field = document.getElementById('student-id-field');
  const note = document.getElementById('staff-note');
  const input = document.querySelector<HTMLInputElement>(
    'input[name="student_id"]',
  );
  const radios = document.querySelectorAll<HTMLInputElement>('input.js-role');

  function sync() {
    const selected = document.querySelector<HTMLInputElement>(
      'input.js-role:checked',
    )?.value;
    const isStudent = selected === 'student';
    if (field) field.hidden = !isStudent;
    if (note) note.hidden = isStudent;
    if (input) input.required = isStudent;
  }

  radios.forEach((radio) => radio.addEventListener('change', sync));
  sync();
</script>

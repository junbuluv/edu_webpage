---
import BaseLayout from '@layouts/BaseLayout.astro';
import Quiz from '@components/quiz/Quiz';
import FurtherReadingCard from '@components/lesson/FurtherReadingCard.astro';
import { loadGradableQuiz } from '@lib/quiz/resolve';
import { toPublicQuestions } from '@lib/quiz/public';
import { canViewCourse } from '@lib/archive/access';
import {
  ArchiveServiceUnavailableError,
  QuizInvalidError,
  QuizUnavailableError,
} from '@lib/archive/errors';
import { hasAcceptedCurrentTerms } from '@lib/auth/terms';

// SSR so Astro.locals.user is populated by middleware and the header
// renders the signed-in state. Lookup the quiz by slug on each request.

const { slug } = Astro.params;
if (!slug) {
  return new Response(null, { status: 404 });
}
let quiz: Awaited<ReturnType<typeof loadGradableQuiz>>;
try {
  quiz = await loadGradableQuiz(slug);
} catch (error) {
  if (error instanceof QuizInvalidError) {
    return new Response(
      'This quiz needs instructor review before it can open.',
      {
        status: 422,
        headers: { 'cache-control': 'no-store' },
      },
    );
  }
  if (error instanceof QuizUnavailableError) {
    return new Response('The quiz service is temporarily unavailable.', {
      status: 503,
      headers: { 'cache-control': 'no-store' },
    });
  }
  throw error;
}
if (!quiz) {
  return new Response(null, { status: 404 });
}

// Practice quizzes stay public. Archive papers (exam/assignment) are
// gated to enrolled students + staff so they can't be reached by
// guessing a slug.
if (quiz.kind !== 'practice') {
  if (!Astro.locals.user) {
    return Astro.redirect(
      `/auth/signin?next=${encodeURIComponent(Astro.url.pathname)}`,
    );
  }
  if (!hasAcceptedCurrentTerms(Astro.locals.profile)) {
    return Astro.redirect(
      `/account/terms?next=${encodeURIComponent(Astro.url.pathname)}`,
    );
  }
  try {
    if (!(await canViewCourse(Astro.locals, quiz.course))) {
      return Astro.redirect(`/${quiz.course}/archive`);
    }
  } catch (error) {
    if (error instanceof ArchiveServiceUnavailableError) {
      return new Response('Archive access is temporarily unavailable.', {
        status: 503,
        headers: { 'cache-control': 'no-store' },
      });
    }
    throw error;
  }
}

const kindLabel =
  quiz.kind === 'exam'
    ? 'Exam'
    : quiz.kind === 'assignment'
      ? 'Assignment'
      : 'Practice';
---

<BaseLayout title={quiz.title}>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <p class="text-xs uppercase tracking-wide text-accent font-medium">
      {kindLabel} · {quiz.course}
    </p>
    <h1 class="text-2xl font-semibold tracking-tight mt-2">{quiz.title}</h1>

    <Quiz
      client:load
      slug={quiz.slug}
      title={quiz.title}
      questions={toPublicQuestions(quiz.questions)}
      passingScore={quiz.passingScore}
    />

    {
      quiz.furtherReading && (
        <FurtherReadingCard article={quiz.furtherReading} variant="quiz" />
      )
    }

    {
      quiz.lessonSlug && (
        <p class="mt-8">
          <a
            href={`/lessons/${quiz.lessonSlug}`}
            class="text-sm text-accent underline"
          >
            ← Back to the lesson
          </a>
        </p>
      )
    }
  </div>
</BaseLayout>

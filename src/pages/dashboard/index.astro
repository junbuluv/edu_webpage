---
import BaseLayout from '@layouts/BaseLayout.astro';
import CourseHeaderCard from '@components/course/CourseHeaderCard.astro';
import LessonProgressList from '@components/course/LessonProgressList.astro';
import DashboardCourseTabs from '@components/course/DashboardCourseTabs.astro';
import StaffCourseManagement from '@components/dashboard/StaffCourseManagement.astro';
import {
  resolveActiveCourse,
  listAvailableCourses,
  getDashboardData,
  type AvailableCourse,
  type CourseDashboardData,
} from '@lib/dashboard';
import { loadStaffMetrics, parseRange } from '@lib/staff-dashboard';
import { isInstructor } from '@lib/roles';
import type { CourseSlug } from '@lib/courses';

const user = Astro.locals.user!;
const supabase = Astro.locals.supabase!;

const courseParam = Astro.url.searchParams.get('course');
let activeSlug: CourseSlug | null = null;
let availableCourses: AvailableCourse[] = [];
let data: CourseDashboardData | null = null;
let dashboardUnavailable = false;

try {
  const resolution = await resolveActiveCourse(supabase, user, courseParam);
  if (resolution.kind === 'redirect') return Astro.redirect(resolution.to);
  activeSlug = resolution.courseSlug;
  availableCourses = await listAvailableCourses(supabase, user.id);
  data = activeSlug
    ? await getDashboardData(supabase, user.id, activeSlug)
    : null;
} catch (error) {
  dashboardUnavailable = true;
  console.error('[dashboard] load_failed', error);
}

// Management metrics follow workshop RLS: instructors and admins only.
const viewerCanManage = isInstructor(Astro.locals.profile?.role);
const range = parseRange(Astro.url.searchParams.get('range'));
let staffMetrics: Awaited<ReturnType<typeof loadStaffMetrics>> | null = null;
let staffMetricsUnavailable = false;
if (viewerCanManage && activeSlug && data) {
  try {
    staffMetrics = await loadStaffMetrics(supabase, activeSlug, range);
  } catch (error) {
    staffMetricsUnavailable = true;
    console.error('[dashboard] staff_metrics_failed', error);
  }
}
---

<BaseLayout title="Dashboard">
  <div class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-semibold tracking-tight">Your dashboard</h1>
    <p class="mt-2 text-ink-muted">Signed in as {user.email}</p>

    {
      dashboardUnavailable && (
        <div
          role="alert"
          class="mt-8 rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900"
        >
          Dashboard data is temporarily unavailable. Your saved work has not
          been reset; refresh to try again.
        </div>
      )
    }

    {
      availableCourses.length > 0 && (
        <div class="mt-8">
          <DashboardCourseTabs
            courses={availableCourses}
            activeSlug={activeSlug}
          />
        </div>
      )
    }

    {
      data && (
        <div class="mt-8 space-y-10">
          {viewerCanManage && staffMetrics && activeSlug && (
            <StaffCourseManagement
              metrics={staffMetrics}
              courseSlug={activeSlug}
              courseCode={data.course.data.code}
              range={range}
            />
          )}
          {viewerCanManage && staffMetricsUnavailable && (
            <div
              role="alert"
              class="rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900"
            >
              Class-management metrics are temporarily unavailable.
            </div>
          )}
          {data.enrolledSemester === null && (
            <div class="rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">
              <p>
                <strong>Browse mode.</strong> You're not enrolled in this
                course. You can read lessons and try the practice quizzes, but
                enrollment-only features (proctored quizzes, instructor support,
                roster-scoped exam administrations) won't appear until your
                instructor adds you to the roster.
              </p>
            </div>
          )}
          <CourseHeaderCard
            course={data.course}
            instructors={data.instructors}
            enrolledSemester={data.enrolledSemester}
            stats={data.stats}
          />

          {data.attendance && (
            <section>
              <h2 class="text-xl font-semibold">Workshop attendance</h2>
              <div class="mt-4 rounded-lg border border-slate-200 p-4">
                {data.attendance.openNow && (
                  <a
                    href={`/workshops/${data.attendance.openNow.workshopSlug}`}
                    class="mb-4 flex items-center justify-between rounded bg-accent px-4 py-3 font-medium text-white"
                  >
                    <span>A workshop window is open now — stamp in</span>
                    <span aria-hidden="true">→</span>
                  </a>
                )}
                <p class="text-sm text-ink-muted">
                  Attended {data.attendance.attendedCount} of{' '}
                  {
                    data.attendance.weeks.filter(
                      (w) => w.cell === 'attended' || w.cell === 'missed',
                    ).length
                  }{' '}
                  closed weeks
                </p>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {data.attendance.weeks.map((w) => (
                    <li
                      class={`rounded border px-2 py-1 text-center text-xs ${
                        w.cell === 'attended'
                          ? 'border-emerald-300 bg-emerald-50 text-emerald-700'
                          : w.cell === 'missed'
                            ? 'border-rose-300 bg-rose-50 text-rose-700'
                            : 'border-slate-200 bg-slate-50 text-ink-muted'
                      }`}
                      title={`Week of ${w.weekOf}: ${w.cell}`}
                    >
                      <span class="block whitespace-nowrap">
                        {w.weekOf.slice(5).replace('-', '/')}
                      </span>
                      <span class="block text-sm">
                        {w.cell === 'attended'
                          ? '✓'
                          : w.cell === 'missed'
                            ? '✗'
                            : '·'}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            </section>
          )}

          <section>
            <h2 class="text-xl font-semibold">Lessons</h2>
            <div class="mt-4">
              <LessonProgressList
                lessons={data.lessons}
                progressBySlug={data.progressBySlug}
              />
            </div>
          </section>

          <section>
            <h2 class="text-xl font-semibold">Recent quiz attempts</h2>
            {data.quizAttempts.length > 0 ? (
              <ul class="mt-4 divide-y divide-slate-200 rounded border border-slate-200">
                {data.quizAttempts.slice(0, 20).map((a) => (
                  <li class="flex items-baseline justify-between px-4 py-3">
                    <a
                      href={`/practice/${a.quiz_slug}`}
                      class="text-accent underline"
                    >
                      {a.title}
                    </a>
                    <span class="text-sm text-ink-muted">
                      {a.score} / {a.max_score} ·{' '}
                      {new Date(a.submitted_at).toLocaleDateString()}
                    </span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-2 text-ink-muted">
                No quiz attempts in this course yet.
              </p>
            )}
          </section>
        </div>
      )
    }

    {
      !dashboardUnavailable && !data && availableCourses.length === 0 && (
        <div class="mt-10 rounded border border-amber-300 bg-amber-50 p-6 text-sm text-amber-900">
          <p class="font-medium">You don't have any active courses yet.</p>
          <p class="mt-2">
            Once your instructor enrolls you, or once you start a lesson or
            quiz, your course-scoped progress will appear here. Browse the
            available courses from the navigation above to get started.
          </p>
        </div>
      )
    }

    <section class="mt-12 border-t border-slate-200 pt-6">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-muted">
        Account
      </h2>
      <p class="mt-3 text-sm">
        <a class="text-red-700 underline" href="/account/delete"
          >Delete my account</a
        >
        <span class="ml-2 text-ink-muted">— permanently removes your data.</span
        >
      </p>
    </section>
  </div>
</BaseLayout>

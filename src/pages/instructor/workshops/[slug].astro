---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import { isAdmin as isAdminRole, isInstructor } from '@lib/roles';
import { getAdminClient, selectAllRows } from '@lib/supabase/admin';
import { logDisclosureSafe } from '@lib/audit';
import {
  canUseStudentWorkshopAttendance,
  formatNewYorkDateTime,
  formatWeekOf,
  newYorkDateTimeInputValue,
  workshopWindowStatus,
} from '@lib/workshop-policy';

const user = Astro.locals.user!;
const supabase = Astro.locals.supabase!;
const role = Astro.locals.profile?.role ?? 'student';
if (!isInstructor(role)) return new Response(null, { status: 403 });
const viewerIsAdmin = isAdminRole(role);
const admin = getAdminClient();

const { slug } = Astro.params;
if (!slug) return new Response(null, { status: 404 });

const workshop = await getEntry('workshops', slug);
if (!workshop) return new Response(null, { status: 404 });
const SECTIONS = ['CML', 'CTL', 'CWL', 'CRL'] as const;
const courseUsesSections = workshop.data.course === 'eco-1002';

const assignmentRowsResult = await selectAllRows<{
  instructor_id: string;
  semester: string;
  assigned_at: string;
}>((from, to) => {
  let query = admin
    .from('teaching_assignments')
    .select('instructor_id, semester, assigned_at')
    .eq('course_slug', workshop.data.course)
    .eq('active', true);
  if (!viewerIsAdmin) query = query.eq('instructor_id', user.id);
  return query
    .order('assigned_at', { ascending: false })
    .order('semester', { ascending: true })
    .order('instructor_id', { ascending: true })
    .range(from, to);
});
const assignmentRowsError = assignmentRowsResult.error;
if (!viewerIsAdmin && assignmentRowsError) {
  return new Response('Teaching assignments are temporarily unavailable.', {
    status: 503,
    headers: { 'retry-after': '30' },
  });
}
if (!viewerIsAdmin && assignmentRowsResult.rows.length === 0) {
  return new Response(null, { status: 403 });
}
const activeViewerSemesters = assignmentRowsResult.rows.map(
  (row) => row.semester,
);
const classOptions = assignmentRowsResult.rows.flatMap((row) =>
  (courseUsesSections ? SECTIONS : [null]).map((section) => ({
    instructorId: row.instructor_id,
    semester: row.semester,
    section,
    assignedAt: row.assigned_at,
  })),
);
const classInstructorIds = [
  ...new Set(classOptions.map((item) => item.instructorId)),
];
const instructorNameById = new Map<string, string | null>();
if (classInstructorIds.length > 0) {
  const { data: instructorProfiles } = await admin
    .from('profiles')
    .select('id, display_name')
    .in('id', classInstructorIds);
  for (const profile of instructorProfiles ?? []) {
    instructorNameById.set(profile.id, profile.display_name);
  }
}
classOptions.sort(
  (a, b) =>
    b.assignedAt.localeCompare(a.assignedAt) ||
    b.semester.localeCompare(a.semester) ||
    a.instructorId.localeCompare(b.instructorId) ||
    (a.section ?? '').localeCompare(b.section ?? ''),
);
const administrationsResult = await selectAllRows<{
  id: string;
  semester: string;
  section: 'CML' | 'CTL' | 'CWL' | 'CRL' | null;
  week_of: string;
  instructor_id: string;
  opens_at: string;
  closes_at: string;
  required_lat: number | null;
  required_lng: number | null;
  required_radius_meters: number;
  location_label: string;
  questions_revealed_at: string | null;
  cancelled_at: string | null;
  notes: string | null;
}>((from, to) => {
  let query = admin
    .from('workshop_administrations')
    .select(
      'id, semester, section, week_of, instructor_id, opens_at, closes_at, required_lat, required_lng, required_radius_meters, location_label, questions_revealed_at, cancelled_at, notes',
    )
    .eq('workshop_slug', slug);
  if (!viewerIsAdmin) {
    query = query
      .eq('instructor_id', user.id)
      .in('semester', activeViewerSemesters);
  }
  return query
    .order('week_of', { ascending: false })
    .order('section', { ascending: true })
    .order('id', { ascending: true })
    .range(from, to);
});
const admins = administrationsResult.rows;
const administrationsError = administrationsResult.error;

const adminIds = admins.map((administration) => administration.id);
let attendance: Array<{
  administration_id: string;
  user_id: string;
  stamped_at: string;
  verification_method: 'geofence' | 'window' | 'manual' | 'legacy';
  recorded_by: string | null;
  correction_reason: string | null;
}> = [];
let attendanceReadFailed = false;
if (adminIds.length > 0) {
  for (let start = 0; start < adminIds.length; start += 100) {
    const administrationIdBatch = adminIds.slice(start, start + 100);
    const result = await selectAllRows<(typeof attendance)[number]>(
      (from, to) =>
        admin
          .from('workshop_attendance')
          .select(
            'administration_id, user_id, stamped_at, verification_method, recorded_by, correction_reason',
          )
          .in('administration_id', administrationIdBatch)
          .order('stamped_at', { ascending: true })
          .order('administration_id', { ascending: true })
          .order('user_id', { ascending: true })
          .range(from, to),
    );
    if (result.error) {
      attendanceReadFailed = true;
      attendance = [];
      break;
    }
    attendance.push(...result.rows);
  }
}

const semestersInView = [...new Set(admins.map((row) => row.semester))];
let enrollmentRows: Array<{
  user_id: string;
  instructor_id: string;
  semester: string;
  section: string | null;
  student_name: string | null;
}> = [];
let enrollmentReadFailed = false;
let profileRolesReadFailed = false;
if (semestersInView.length > 0) {
  const result = await selectAllRows<(typeof enrollmentRows)[number]>(
    (from, to) =>
      supabase
        .from('enrollments')
        .select('user_id, instructor_id, semester, section, student_name')
        .eq('course_slug', workshop.data.course)
        .in('semester', semestersInView)
        .order('semester', { ascending: true })
        .order('user_id', { ascending: true })
        .range(from, to),
  );
  enrollmentReadFailed = result.error != null;
  enrollmentRows = result.rows;
}
if (!enrollmentReadFailed && enrollmentRows.length > 0) {
  const studentUserIds = new Set<string>();
  const enrollmentUserIds = [
    ...new Set(enrollmentRows.map((enrollment) => enrollment.user_id)),
  ];
  for (let start = 0; start < enrollmentUserIds.length; start += 100) {
    const userIdBatch = enrollmentUserIds.slice(start, start + 100);
    const { data: profiles, error } = await admin
      .from('profiles')
      .select('id, role')
      .in('id', userIdBatch);
    if (error) {
      profileRolesReadFailed = true;
      enrollmentRows = [];
      break;
    }
    for (const profile of profiles ?? []) {
      if (canUseStudentWorkshopAttendance(profile.role)) {
        studentUserIds.add(profile.id);
      }
    }
  }
  if (!profileRolesReadFailed) {
    enrollmentRows = enrollmentRows.filter((enrollment) =>
      studentUserIds.has(enrollment.user_id),
    );
  }
}
const dataUnavailable = Boolean(
  assignmentRowsError ||
  administrationsError ||
  attendanceReadFailed ||
  enrollmentReadFailed ||
  profileRolesReadFailed,
);

const stampsByAdmin = new Map<string, typeof attendance>();
for (const row of attendance) {
  const rows = stampsByAdmin.get(row.administration_id) ?? [];
  rows.push(row);
  stampsByAdmin.set(row.administration_id, rows);
}

const studentNameByScope = new Map<string, string>();
for (const enrollment of enrollmentRows) {
  if (!enrollment.student_name) continue;
  studentNameByScope.set(
    `${enrollment.user_id}::${enrollment.semester}`,
    enrollment.student_name,
  );
}

function studentName(userId: string, semester: string): string | null {
  return studentNameByScope.get(`${userId}::${semester}`) ?? null;
}

const csvRequested = Astro.url.searchParams.get('format') === 'csv';
if (csvRequested && dataUnavailable) {
  return new Response('Workshop records are temporarily unavailable.', {
    status: 503,
    headers: { 'retry-after': '30' },
  });
}
if (
  !dataUnavailable &&
  (attendance.length > 0 || enrollmentRows.length > 0) &&
  !csvRequested
) {
  await logDisclosureSafe({
    actorId: user.id,
    actorRole: role as 'instructor' | 'admin',
    action: 'read_class_roster',
    targetResource: slug,
    metadata: {
      kind: 'workshop_attendance',
      attendance_rows: attendance.length,
      roster_rows: enrollmentRows.length,
    },
    request: Astro.request,
  });
}

function csvCell(value: string | null): string {
  let safe = value ?? '';
  if (/^[=+\-@\t\r]/.test(safe)) safe = `'${safe}`;
  return /[",\n]/.test(safe) ? `"${safe.replace(/"/g, '""')}"` : safe;
}

if (csvRequested) {
  const lines = [
    'administration_id,semester,section,week_of,user_id,student_name,stamped_at,verification_method,correction_reason',
  ];
  const adminById = new Map(admins.map((row) => [row.id, row]));
  for (const row of attendance) {
    const administration = adminById.get(row.administration_id);
    if (!administration) continue;
    lines.push(
      [
        row.administration_id,
        administration.semester,
        administration.section ?? '',
        administration.week_of,
        row.user_id,
        studentName(row.user_id, administration.semester) ?? '',
        row.stamped_at,
        row.verification_method,
        row.correction_reason ?? '',
      ]
        .map((value) => csvCell(String(value)))
        .join(','),
    );
  }
  await logDisclosureSafe({
    actorId: user.id,
    actorRole: role as 'instructor' | 'admin',
    action: 'export_student_data',
    targetResource: slug,
    metadata: {
      kind: 'workshop_attendance_csv',
      rows: attendance.length,
    },
    request: Astro.request,
  });
  return new Response(lines.join('\n'), {
    status: 200,
    headers: {
      'content-type': 'text/csv; charset=utf-8',
      'content-disposition': `attachment; filename="${slug}-attendance.csv"`,
      'cache-control': 'private, no-store',
      'x-content-type-options': 'nosniff',
    },
  });
}

const okParam = Astro.url.searchParams.get('ok');
const errorParam = Astro.url.searchParams.get('error');
const OK_MESSAGES: Record<string, string> = {
  opened: 'Workshop window opened.',
  closed: 'Window closed.',
  cancelled: 'Upcoming window cancelled.',
  revealed: 'Discussion questions revealed to stamped-in students.',
  attendance_recorded: 'Manual attendance recorded.',
  attendance_removed: 'The mistaken manual attendance mark was removed.',
  already_recorded: 'Attendance was already recorded for that student.',
};
const ERROR_MESSAGES: Record<string, string> = {
  unauthenticated: 'You need to sign in to manage workshop windows.',
  forbidden: "You don't have permission to manage workshop windows.",
  invalid_input: 'Some required fields were missing or invalid.',
  lookup_failed: 'Workshop records could not be loaded. Refresh and retry.',
  not_found: 'That workshop window no longer exists.',
  update_failed: 'The server could not update that workshop window.',
  attendance_lookup_failed:
    'Attendance records could not be loaded. Refresh and retry.',
  enrollment_lookup_failed:
    'The class roster could not be loaded. Refresh and retry.',
  profile_lookup_failed:
    'The selected account role could not be checked. Refresh and retry.',
  role_not_student:
    'Manual attendance can only be recorded for a student account.',
  not_enrolled: 'That student is no longer enrolled in this class.',
  wrong_instructor: 'That student belongs to a different instructor roster.',
  wrong_section: 'That student belongs to a different section.',
  section_assignment_required:
    'That student needs a section assignment before attendance can be recorded.',
  invalid_time: 'Enter valid opening and closing times.',
  ambiguous_or_missing_time:
    'That time falls in a daylight-saving transition. Choose an unambiguous time.',
  invalid_window:
    'The window must last more than zero and no more than 24 hours.',
  wrong_section_day:
    'ECO sections must open on their assigned day: CML Monday, CTL Tuesday, CWL Wednesday, or CRL Thursday.',
  invalid_location:
    'Enter a valid location, coordinates, and radius from 10 to 50,000 meters.',
  not_course_instructor:
    "You're not the instructor for that course and semester.",
  already_opened:
    'That workshop window already exists for this semester and week.',
  insert_failed: 'The server could not save the workshop window.',
  attendance_insert_failed:
    'The server could not save that manual attendance mark.',
  window_not_open:
    'Wait until the workshop opens before revealing questions or recording attendance.',
  window_cancelled:
    'That workshop window was cancelled and can no longer be changed.',
  manual_attendance_not_found:
    'That manual attendance mark no longer exists or cannot be removed.',
  audit_unavailable:
    'The attendance mark was not changed because its audit record could not be saved. Retry later.',
  remove_failed: 'The server could not remove that manual attendance mark.',
};
const okMessage = okParam ? (OK_MESSAGES[okParam] ?? null) : null;
const errorMessage = errorParam
  ? (ERROR_MESSAGES[errorParam] ?? `Unknown error: ${errorParam}`)
  : null;

const defaultOpensAt = newYorkDateTimeInputValue(new Date());
const defaultClosesAt = newYorkDateTimeInputValue(
  new Date(Date.now() + 2 * 60 * 60 * 1000),
);
---

<BaseLayout title={`Manage: ${workshop.data.title}`}>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <p class="text-xs uppercase tracking-wide text-accent font-medium">
      {workshop.data.course} · Instructor
    </p>
    <h1 class="mt-1 text-3xl font-semibold tracking-tight">
      {workshop.data.title}
    </h1>
    <p class="mt-3 text-ink-muted">{workshop.data.summary}</p>

    {
      okMessage && (
        <div
          role="status"
          class="mt-6 rounded-lg border border-emerald-300 bg-emerald-50 p-4 text-sm text-emerald-900"
        >
          {okMessage}
        </div>
      )
    }
    {
      errorMessage && (
        <div
          role="alert"
          class="mt-6 rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900"
        >
          {errorMessage}
        </div>
      )
    }
    {
      dataUnavailable && (
        <div
          role="alert"
          class="mt-6 rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900"
        >
          Workshop or roster records are temporarily unavailable. Opening,
          closing, revealing, correcting, and exporting are disabled so an
          incomplete read cannot be mistaken for an empty class. Refresh and
          retry.
        </div>
      )
    }

    <details class="mt-8 rounded-lg border border-slate-200 p-5">
      <summary class="cursor-pointer font-semibold">Facilitator guide</summary>
      <ol class="mt-4 list-decimal space-y-4 pl-5 text-sm">
        {
          workshop.data.questions.map((question) => (
            <li>
              <p class="font-medium">{question.prompt}</p>
              {question.notes && (
                <p class="mt-1 text-ink-muted">{question.notes}</p>
              )}
            </li>
          ))
        }
      </ol>
    </details>

    <section class="mt-8 rounded-lg border border-slate-200 p-5">
      <h2 class="text-lg font-semibold">
        {
          courseUsesSections
            ? 'Open a new section window'
            : 'Open a new workshop window'
        }
      </h2>
      <p
        class="mt-2 rounded border border-amber-200 bg-amber-50 p-3 text-xs text-amber-950"
      >
        Location is a convenience check, not proof of attendance. Browser
        permissions and accuracy can fail; verify attendance in the room and use
        the correction tool when needed.
      </p>

      {
        dataUnavailable ? (
          <p class="mt-4 text-sm text-ink-muted">
            Scheduling controls are unavailable until all records load.
          </p>
        ) : classOptions.length === 0 ? (
          <p class="mt-4 text-sm text-ink-muted">
            An active teaching assignment is required before opening a workshop
            window.
          </p>
        ) : (
          <form
            method="POST"
            action="/api/instructor/workshops/open"
            class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-2"
          >
            <input
              type="hidden"
              name="workshop_slug"
              value={workshop.data.slug}
            />
            <input
              type="hidden"
              name="course_slug"
              value={workshop.data.course}
            />

            <label class="text-sm">
              <span class="font-medium">
                Class / semester{courseUsesSections ? ' / section' : ''}
              </span>
              <select
                name="class_key"
                required
                class="mt-1 block w-full rounded border border-slate-300 px-2 py-1.5"
              >
                <option value="" selected disabled>
                  Choose a class…
                </option>
                {classOptions.map((classOption) => (
                  <option
                    value={JSON.stringify({
                      instructorId: classOption.instructorId,
                      semester: classOption.semester,
                      section: classOption.section,
                    })}
                  >
                    {classOption.semester}
                    {classOption.section ? ` · ${classOption.section}` : ''}
                    {viewerIsAdmin
                      ? ` — ${instructorNameById.get(classOption.instructorId) ?? `Instructor ${classOption.instructorId.slice(0, 8)}`}`
                      : ''}
                  </option>
                ))}
              </select>
            </label>

            <label class="text-sm">
              <span class="font-medium">Opens at (New York time)</span>
              <input
                type="datetime-local"
                name="opens_at"
                required
                value={defaultOpensAt}
                class="mt-1 block w-full rounded border border-slate-300 px-2 py-1.5"
              />
            </label>

            <label class="text-sm">
              <span class="font-medium">Closes at (New York time)</span>
              <input
                type="datetime-local"
                name="closes_at"
                required
                value={defaultClosesAt}
                class="mt-1 block w-full rounded border border-slate-300 px-2 py-1.5"
              />
            </label>

            <label class="text-sm md:col-span-2">
              <span class="font-medium">Meeting location</span>
              <input
                type="text"
                name="location_label"
                required
                maxlength="120"
                value="55 Lexington Ave"
                class="mt-1 block w-full rounded border border-slate-300 px-2 py-1.5"
              />
            </label>

            <label class="text-sm">
              <span class="font-medium">Latitude</span>
              <input
                type="number"
                name="required_lat"
                required
                min="-90"
                max="90"
                step="0.00001"
                value="40.74110"
                class="mt-1 block w-full rounded border border-slate-300 px-2 py-1.5"
              />
            </label>

            <label class="text-sm">
              <span class="font-medium">Longitude</span>
              <input
                type="number"
                name="required_lng"
                required
                min="-180"
                max="180"
                step="0.00001"
                value="-73.98370"
                class="mt-1 block w-full rounded border border-slate-300 px-2 py-1.5"
              />
            </label>

            <label class="text-sm">
              <span class="font-medium">Geofence radius (m)</span>
              <input
                type="number"
                name="required_radius_meters"
                required
                min="10"
                max="50000"
                step="1"
                value="200"
                class="mt-1 block w-full rounded border border-slate-300 px-2 py-1.5"
              />
            </label>

            <label class="text-sm md:col-span-2">
              <span class="font-medium">Notes (optional)</span>
              <input
                type="text"
                name="notes"
                maxlength="200"
                class="mt-1 block w-full rounded border border-slate-300 px-2 py-1.5"
              />
            </label>

            <p class="text-xs text-ink-muted md:col-span-2">
              The week begins Monday and is derived automatically from the
              opening time.
            </p>

            <div class="md:col-span-2">
              <button
                type="submit"
                class="rounded bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-blue-700"
              >
                {courseUsesSections
                  ? 'Open section window'
                  : 'Open workshop window'}
              </button>
            </div>
          </form>
        )
      }
    </section>

    <section class="mt-10">
      <div class="flex items-center justify-between gap-3">
        <h2 class="text-lg font-semibold">Workshop windows and attendance</h2>
        {
          !dataUnavailable && (admins?.length ?? 0) > 0 && (
            <a
              href={`/instructor/workshops/${slug}?format=csv`}
              class="rounded border border-slate-300 px-2 py-1 text-sm hover:border-accent"
            >
              Download CSV
            </a>
          )
        }
      </div>

      {
        !dataUnavailable && (admins?.length ?? 0) === 0 && (
          <p class="mt-3 text-sm text-ink-muted">
            No workshop windows opened yet.
          </p>
        )
      }

      {
        !dataUnavailable && (admins?.length ?? 0) > 0 && (
          <ul class="mt-4 space-y-4">
            {(admins ?? []).map((administration) => {
              const status = workshopWindowStatus(
                administration.opens_at,
                administration.closes_at,
                administration.cancelled_at,
              );
              const stamps = stampsByAdmin.get(administration.id) ?? [];
              const stampedUsers = new Set(
                stamps.map((stamp) => stamp.user_id),
              );
              const eligibleStudents = enrollmentRows.filter(
                (enrollment) =>
                  enrollment.semester === administration.semester &&
                  enrollment.instructor_id === administration.instructor_id &&
                  (administration.section == null ||
                    enrollment.section === administration.section),
              );
              const missingStudents = eligibleStudents.filter(
                (enrollment) => !stampedUsers.has(enrollment.user_id),
              );
              const sessionLabel = `${administration.semester}${administration.section ? ` section ${administration.section}` : ''}, week of ${formatWeekOf(administration.week_of)}`;
              const sessionHeadingId = `workshop-session-${administration.id}`;
              return (
                <li class="rounded-lg border border-slate-200 p-4">
                  <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                      <h3 id={sessionHeadingId} class="text-sm font-medium">
                        {administration.semester} ·{' '}
                        {administration.section ? (
                          <>Section {administration.section} · </>
                        ) : null}
                        week of {formatWeekOf(administration.week_of)}
                      </h3>
                      <p class="mt-1 text-xs text-ink-muted">
                        {formatNewYorkDateTime(administration.opens_at)} —{' '}
                        {formatNewYorkDateTime(administration.closes_at)} ET
                      </p>
                      <p class="mt-0.5 text-xs text-ink-muted">
                        {administration.location_label}
                        {administration.required_lat != null ? (
                          <>
                            {' '}
                            · within {administration.required_radius_meters} m ·
                            ({administration.required_lat},{' '}
                            {administration.required_lng})
                          </>
                        ) : (
                          <> · no location check</>
                        )}
                      </p>
                      {administration.notes && (
                        <p class="mt-1 text-xs text-ink-muted">
                          {administration.notes}
                        </p>
                      )}
                    </div>
                    <div class="text-right">
                      <span
                        class:list={[
                          'inline-block whitespace-nowrap rounded px-2 py-0.5 text-xs font-semibold uppercase',
                          status === 'open'
                            ? 'bg-emerald-100 text-emerald-800'
                            : status === 'upcoming'
                              ? 'bg-amber-100 text-amber-800'
                              : status === 'cancelled'
                                ? 'bg-rose-100 text-rose-800'
                                : 'bg-slate-200 text-slate-700',
                        ]}
                      >
                        {status}
                      </span>
                      <p class="mt-1 text-xs text-ink-muted">
                        {stamps.length} stamped
                      </p>
                    </div>
                  </div>

                  <div class="mt-3 flex flex-wrap gap-2">
                    {(status === 'open' || status === 'upcoming') && (
                      <form
                        method="POST"
                        action="/api/instructor/workshops/close"
                        data-confirm={`${
                          status === 'upcoming' ? 'Cancel' : 'Close'
                        } ${sessionLabel}? This cannot be undone from the app.`}
                      >
                        <input
                          type="hidden"
                          name="administration_id"
                          value={administration.id}
                        />
                        <input
                          type="hidden"
                          name="workshop_slug"
                          value={workshop.data.slug}
                        />
                        <button
                          type="submit"
                          aria-label={`${status === 'upcoming' ? 'Cancel window' : 'Close window now'} for ${sessionLabel}`}
                          class="rounded border border-rose-300 px-2 py-1 text-xs text-rose-800 hover:bg-rose-50"
                        >
                          {status === 'upcoming'
                            ? 'Cancel window'
                            : 'Close window now'}
                        </button>
                      </form>
                    )}
                    {administration.questions_revealed_at == null &&
                    (status === 'open' || status === 'closed') ? (
                      <form
                        method="POST"
                        action="/api/instructor/workshops/reveal"
                        data-confirm={`Reveal discussion questions for ${sessionLabel}? Students who stamped in will see them immediately.`}
                      >
                        <input
                          type="hidden"
                          name="administration_id"
                          value={administration.id}
                        />
                        <input
                          type="hidden"
                          name="workshop_slug"
                          value={workshop.data.slug}
                        />
                        <button
                          type="submit"
                          aria-label={`Reveal discussion questions for ${sessionLabel}`}
                          class="rounded border border-sky-300 px-2 py-1 text-xs text-sky-800 hover:bg-sky-50"
                        >
                          Reveal discussion questions
                        </button>
                      </form>
                    ) : administration.questions_revealed_at != null ? (
                      <span class="rounded bg-sky-100 px-2 py-1 text-xs font-medium text-sky-900">
                        Questions revealed
                      </span>
                    ) : null}
                  </div>

                  {stamps.length > 0 && (
                    <details class="mt-3 text-sm">
                      <summary class="cursor-pointer text-ink-muted">
                        Show attendance ({stamps.length})
                      </summary>
                      <ul class="mt-2 divide-y divide-slate-200 rounded border border-slate-200">
                        {stamps.map((stamp) => (
                          <li class="px-3 py-2 text-xs">
                            <div class="flex flex-wrap justify-between gap-3">
                              <span>
                                {studentName(
                                  stamp.user_id,
                                  administration.semester,
                                ) ?? stamp.user_id}
                                {studentName(
                                  stamp.user_id,
                                  administration.semester,
                                ) && (
                                  <code class="ml-2 text-ink-muted">
                                    {stamp.user_id}
                                  </code>
                                )}
                              </span>
                              <span class="text-ink-muted">
                                {formatNewYorkDateTime(stamp.stamped_at)} ·{' '}
                                {stamp.verification_method}
                              </span>
                            </div>
                            {stamp.correction_reason && (
                              <p class="mt-1 text-ink-muted">
                                Manual reason: {stamp.correction_reason}
                              </p>
                            )}
                            {stamp.verification_method === 'manual' && (
                              <details class="mt-2 rounded border border-rose-200 p-2">
                                <summary class="cursor-pointer text-rose-800">
                                  Correct a mistaken manual mark
                                </summary>
                                <form
                                  method="POST"
                                  action="/api/instructor/workshops/attendance"
                                  data-confirm={`Remove the manual attendance mark for ${
                                    studentName(
                                      stamp.user_id,
                                      administration.semester,
                                    ) ?? stamp.user_id
                                  } from ${sessionLabel}? The removal request is written to the audit log.`}
                                  class="mt-2 grid gap-2 sm:grid-cols-[1fr_auto]"
                                >
                                  <input
                                    type="hidden"
                                    name="operation"
                                    value="remove"
                                  />
                                  <input
                                    type="hidden"
                                    name="administration_id"
                                    value={administration.id}
                                  />
                                  <input
                                    type="hidden"
                                    name="workshop_slug"
                                    value={workshop.data.slug}
                                  />
                                  <input
                                    type="hidden"
                                    name="user_id"
                                    value={stamp.user_id}
                                  />
                                  <label class="text-xs">
                                    <span class="font-medium">
                                      Removal reason
                                    </span>
                                    <input
                                      name="reason"
                                      required
                                      maxlength="200"
                                      placeholder="Selected the wrong student"
                                      class="mt-1 block w-full rounded border border-slate-300 px-2 py-1.5"
                                    />
                                  </label>
                                  <button
                                    type="submit"
                                    aria-label={`Remove manual mark for ${
                                      studentName(
                                        stamp.user_id,
                                        administration.semester,
                                      ) ?? stamp.user_id
                                    } from ${sessionLabel}`}
                                    class="self-end rounded border border-rose-300 px-2 py-1.5 text-xs text-rose-900 hover:bg-rose-50"
                                  >
                                    Remove manual mark
                                  </button>
                                </form>
                              </details>
                            )}
                          </li>
                        ))}
                      </ul>
                    </details>
                  )}

                  {missingStudents.length > 0 &&
                    (status === 'open' || status === 'closed') && (
                      <details class="mt-3 rounded border border-slate-200 p-3 text-sm">
                        <summary class="cursor-pointer font-medium">
                          Record manual attendance
                        </summary>
                        <form
                          method="POST"
                          action="/api/instructor/workshops/attendance"
                          data-confirm-student={`Record manual attendance for ${sessionLabel}?`}
                          class="mt-3 grid gap-2 md:grid-cols-2"
                        >
                          <input type="hidden" name="operation" value="add" />
                          <input
                            type="hidden"
                            name="administration_id"
                            value={administration.id}
                          />
                          <input
                            type="hidden"
                            name="workshop_slug"
                            value={workshop.data.slug}
                          />
                          <label class="text-xs">
                            <span class="font-medium">Student</span>
                            <select
                              name="user_id"
                              required
                              class="mt-1 block w-full rounded border border-slate-300 px-2 py-1.5"
                            >
                              <option value="" selected disabled>
                                Choose a student…
                              </option>
                              {missingStudents.map((student) => (
                                <option value={student.user_id}>
                                  {student.student_name ?? 'Student'} ·{' '}
                                  {student.user_id.slice(0, 8)}
                                  {student.section
                                    ? ` (${student.section})`
                                    : ''}
                                </option>
                              ))}
                            </select>
                          </label>
                          <label class="text-xs">
                            <span class="font-medium">Reason</span>
                            <input
                              name="reason"
                              required
                              maxlength="200"
                              placeholder="Instructor verified in room"
                              class="mt-1 block w-full rounded border border-slate-300 px-2 py-1.5"
                            />
                          </label>
                          <div class="md:col-span-2">
                            <button
                              type="submit"
                              aria-label={`Mark present for ${sessionLabel}`}
                              class="rounded border border-emerald-300 px-2 py-1 text-xs text-emerald-900 hover:bg-emerald-50"
                            >
                              Mark present
                            </button>
                          </div>
                        </form>
                      </details>
                    )}
                </li>
              );
            })}
          </ul>
        )
      }
    </section>

    <p class="mt-8 text-sm">
      <a class="text-accent underline" href={`/workshops/${slug}`}
        >Preview student page (stamping disabled) →</a
      >
    </p>
  </div>
</BaseLayout>

<script>
  let workshopConfirmationController: AbortController | null = null;

  function initializeWorkshopConfirmations() {
    workshopConfirmationController?.abort();
    workshopConfirmationController = new AbortController();
    document.addEventListener(
      'submit',
      (event) => {
        if (!(event.target instanceof HTMLFormElement)) return;
        const form = event.target;
        if (!form.matches('form[data-confirm], form[data-confirm-student]')) {
          return;
        }
        let message = form.dataset.confirm;
        if (form.dataset.confirmStudent) {
          const student = form
            .querySelector<HTMLSelectElement>('select[name="user_id"]')
            ?.selectedOptions[0]?.textContent?.trim();
          message = `${form.dataset.confirmStudent}\n\nStudent: ${student ?? 'unknown'}`;
        }
        if (message && !window.confirm(message)) event.preventDefault();
      },
      { capture: true, signal: workshopConfirmationController.signal },
    );
  }

  document.addEventListener('astro:page-load', initializeWorkshopConfirmations);
  document.addEventListener('astro:before-swap', () =>
    workshopConfirmationController?.abort(),
  );
  initializeWorkshopConfirmations();
</script>

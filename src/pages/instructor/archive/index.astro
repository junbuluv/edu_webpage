---
import BaseLayout from '@layouts/BaseLayout.astro';
import PaperUploadForm from '@components/archive/PaperUploadForm';
import { isStaff, isAdmin } from '@lib/roles';
import { loadInstructorArchive } from '@lib/instructor/archive-manage';
import { partitionByOwnership } from '@lib/instructor/archive-ownership';

const user = Astro.locals.user;
const role = Astro.locals.profile?.role ?? 'student';

if (!user) {
  return Astro.redirect(
    `/auth/signin?next=${encodeURIComponent(Astro.url.pathname)}`,
  );
}
if (!isStaff(role)) {
  return Astro.redirect('/dashboard');
}

let archive;
try {
  archive = await loadInstructorArchive(user.id, role);
} catch {
  return new Response(
    'Archive records are temporarily unavailable. Please try again.',
    { status: 503 },
  );
}
const { courses, papers, quizzes } = archive;
const editablePapers = partitionByOwnership(papers, {
  userId: user.id,
  canEditAll: isAdmin(role),
});
const editableQuizzes = partitionByOwnership(quizzes, {
  userId: user.id,
  canEditAll: isAdmin(role),
});
const prefillCourse = Astro.url.searchParams.get('course') ?? '';
const manageCourses = courses; // courses the viewer manages

const ok = Astro.url.searchParams.get('ok');
const error = Astro.url.searchParams.get('error');

const OK_MESSAGES: Record<string, string> = {
  paper_created: 'File uploaded as hidden. Review and publish it when ready.',
  paper_updated: 'Exam/assignment updated.',
  paper_deleted: 'Exam/assignment removed.',
  quiz_created: 'Quiz created as hidden. Review and publish it when ready.',
  quiz_updated: 'Quiz updated.',
  quiz_deleted: 'Quiz removed.',
};
const ERROR_MESSAGES: Record<string, string> = {
  unauthenticated: 'Please sign in.',
  forbidden: 'You do not have permission to manage archive content.',
  not_course_instructor: 'You are not an instructor for that course.',
  not_owner: 'You can only edit items you created.',
  invalid_input: 'Some fields were missing or invalid.',
  invalid_course: 'Unknown course.',
  invalid_lesson: 'One of the selected lessons is not valid for that course.',
  missing_file: 'Please choose a file to upload.',
  bad_file_type: 'Only PDF or Word (.docx) files are allowed.',
  file_too_large: 'The file is too large (max 25 MB).',
  upload_failed: 'Could not upload the file. Please try again.',
  invalid_payload: 'The form could not be read. Please try again.',
  invalid_questions: 'One or more questions are incomplete or invalid.',
  insert_failed: 'Could not save. Please try again.',
  update_failed: 'Could not save changes. Please try again.',
  delete_failed: 'Could not remove the item. Please try again.',
  not_found: 'That item no longer exists.',
};
const okMessage = ok ? (OK_MESSAGES[ok] ?? 'Saved.') : null;
const errorMessage = error
  ? (ERROR_MESSAGES[error] ?? 'Something went wrong.')
  : null;
const currentYear = new Date().getFullYear();
---

<BaseLayout title="Archive content">
  <div class="mx-auto max-w-3xl px-4 py-12">
    <p class="text-xs uppercase tracking-wide text-accent font-medium">
      Instructor
    </p>
    <h1 class="mt-1 text-3xl font-semibold tracking-tight">Archive content</h1>
    <p class="mt-3 text-ink-muted">
      Add past exams and assignments to the course archive. Enrolled students
      see published items; you can edit, hide, or remove what you created. Every
      new item starts hidden so it can be reviewed before students see it.
    </p>

    {
      okMessage && (
        <p
          role="status"
          class="mt-6 rounded border border-green-300 bg-green-50 p-3 text-sm text-green-800"
        >
          {okMessage}
        </p>
      )
    }
    {
      errorMessage && (
        <p
          role="alert"
          class="mt-6 rounded border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900"
        >
          {errorMessage}
        </p>
      )
    }

    <section class="mt-10">
      <h2 class="text-lg font-semibold">Exams &amp; assignments</h2>
      <p class="mt-1 text-sm text-ink-muted">
        Upload a past exam or assignment (PDF or Word, max 25&nbsp;MB). Enrolled
        students download it from the course archive.
      </p>

      {
        manageCourses.length > 0 && (
          <PaperUploadForm
            courses={manageCourses}
            prefillCourse={prefillCourse}
            defaultYear={currentYear}
            client:load
          />
        )
      }

      {
        papers.length === 0 && (
          <p class="mt-3 text-sm text-ink-muted">
            No exams or assignments yet. Upload a file above.
          </p>
        )
      }
      <ul class="mt-3 space-y-2">
        {
          editablePapers.editable.map((p) => (
            <li class="rounded border border-slate-200 p-3 text-sm">
              <div class="flex items-baseline justify-between gap-3">
                <span class="font-medium">{p.title}</span>
                <span class="text-xs text-ink-muted">
                  {p.courseSlug} · {p.kind} · {p.semesterTerm} {p.semesterYear}{' '}
                  · {p.published ? 'published' : 'hidden'}
                </span>
              </div>
              <div class="mt-2 flex gap-3">
                <a
                  href={`/instructor/archive/paper/${p.id}`}
                  class="text-accent underline"
                >
                  Edit
                </a>
                <form
                  method="POST"
                  action="/api/instructor/archive/paper/delete"
                  data-confirm={`Delete “${p.title}”? This hides it from students.`}
                >
                  <input type="hidden" name="id" value={p.id} />
                  <button type="submit" class="text-red-600 underline">
                    Delete
                  </button>
                </form>
              </div>
            </li>
          ))
        }
        {
          editablePapers.readOnly.map((p) => (
            <li class="rounded border border-slate-200 bg-slate-50 p-3 text-sm">
              <span class="font-medium">{p.title}</span>
              <span class="ml-2 text-xs text-ink-muted">
                {p.courseSlug} · added by another instructor
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-10">
      <h2 class="text-lg font-semibold">Interactive quizzes</h2>
      <p class="mt-1 text-sm text-ink-muted">
        Authored quizzes are graded server-side at{' '}
        <code>/practice/&lt;id&gt;</code>. Answers are never sent to the client.
      </p>

      <a
        href="/instructor/archive/quiz/new"
        class="mt-4 inline-block rounded bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent-strong"
      >
        Build a quiz
      </a>

      {
        quizzes.length === 0 && (
          <p class="mt-3 text-sm text-ink-muted">
            No authored quizzes yet. Use the button above to create one.
          </p>
        )
      }
      <ul class="mt-3 space-y-2">
        {
          editableQuizzes.editable.map((q) => (
            <li class="rounded border border-slate-200 p-3 text-sm">
              <div class="flex items-baseline justify-between gap-3">
                <span class="font-medium">{q.title}</span>
                <span class="text-xs text-ink-muted">
                  {q.courseSlug} · {q.kind} · {q.semesterTerm} {q.semesterYear}{' '}
                  · {q.published ? 'published' : 'hidden'}
                </span>
              </div>
              <div class="mt-2 flex gap-3">
                <a
                  href={`/instructor/archive/quiz/${q.id}`}
                  class="text-accent underline"
                >
                  Edit
                </a>
                <form
                  method="POST"
                  action="/api/instructor/archive/quiz/delete"
                  data-confirm={`Delete “${q.title}”? This hides it from students.`}
                >
                  <input type="hidden" name="id" value={q.id} />
                  <button type="submit" class="text-red-600 underline">
                    Delete
                  </button>
                </form>
              </div>
            </li>
          ))
        }
        {
          editableQuizzes.readOnly.map((q) => (
            <li class="rounded border border-slate-200 bg-slate-50 p-3 text-sm">
              <span class="font-medium">{q.title}</span>
              <span class="ml-2 text-xs text-ink-muted">
                {q.courseSlug} · added by another instructor
              </span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<script>
  let archiveConfirmController: AbortController | null = null;

  function initializeArchiveConfirmations() {
    archiveConfirmController?.abort();
    archiveConfirmController = new AbortController();
    document.addEventListener(
      'submit',
      (event) => {
        if (!(event.target instanceof HTMLFormElement)) return;
        const message = event.target.dataset.confirm;
        if (message && !window.confirm(message)) event.preventDefault();
      },
      { capture: true, signal: archiveConfirmController.signal },
    );
  }

  document.addEventListener('astro:page-load', initializeArchiveConfirmations);
  document.addEventListener('astro:before-swap', () =>
    archiveConfirmController?.abort(),
  );
  initializeArchiveConfirmations();
</script>

---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { isContentManager } from '@lib/roles';
import { normalizeLessonSlug } from '@lib/archive/build';
import ArchiveQuizBuilder from '@components/archive/ArchiveQuizBuilder';
import { loadInstructorArchive } from '@lib/instructor/archive-manage';

const user = Astro.locals.user;
const role = Astro.locals.profile?.role ?? 'student';

if (!user) {
  return Astro.redirect(
    `/auth/signin?next=${encodeURIComponent(Astro.url.pathname)}`,
  );
}
if (!isContentManager(role)) return Astro.redirect('/instructor/archive');

let courses: string[];
try {
  ({ courses } = await loadInstructorArchive(user.id, role));
} catch {
  return new Response(
    'Archive records are temporarily unavailable. Please try again.',
    { status: 503 },
  );
}

const prefillCourse = Astro.url.searchParams.get('course') ?? '';
const selectedCourse = courses.includes(prefillCourse)
  ? prefillCourse
  : (courses[0] ?? '');

const allLessons = await getCollection('lessons', (lesson) =>
  courses.includes(lesson.data.course),
);
const lessonsByCourse = Object.fromEntries(
  courses.map((course) => [
    course,
    allLessons
      .filter((lesson) => lesson.data.course === course)
      .map((lesson) => ({
        slug: normalizeLessonSlug(lesson.id),
        title: lesson.data.title,
      }))
      .sort((a, b) => a.title.localeCompare(b.title)),
  ]),
);
const lessons = lessonsByCourse[selectedCourse] ?? [];
---

<BaseLayout title="Build a quiz">
  <div class="mx-auto max-w-3xl px-4 py-12">
    <p class="text-xs font-medium uppercase tracking-wide text-accent">
      Instructor
    </p>
    <h1 class="mt-1 text-3xl font-semibold tracking-tight">Build a quiz</h1>
    <p class="mt-3 text-sm text-ink-muted">
      Author an interactive exam or assignment. Questions are stored server-side
      and graded at <code>/practice/&lt;id&gt;</code>. New quizzes remain hidden
      until you review and publish them from the archive hub.
    </p>

    {
      courses.length === 0 ? (
        <p class="mt-8 rounded border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">
          You do not have an active teaching assignment. Contact an admin before
          authoring quizzes.
        </p>
      ) : (
        <ArchiveQuizBuilder
          client:load
          action="/api/instructor/archive/quiz/create"
          courses={courses}
          lessons={lessons}
          lessonsByCourse={lessonsByCourse}
          initialCourse={selectedCourse}
        />
      )
    }

    <p class="mt-6 text-sm">
      <a href="/instructor/archive" class="text-accent underline">
        Back to archive hub
      </a>
    </p>
  </div>
</BaseLayout>

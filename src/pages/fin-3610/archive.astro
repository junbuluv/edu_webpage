---
import BaseLayout from '@layouts/BaseLayout.astro';
import ArchiveBrowser from '@components/archive/ArchiveBrowser';
import { loadArchiveForCourse } from '@lib/archive/load';
import { canViewCourse } from '@lib/archive/access';
import { isStaff } from '@lib/roles';
import { ArchiveServiceUnavailableError } from '@lib/archive/errors';

const COURSE = 'fin-3610' as const;
const user = Astro.locals.user;

if (!user) {
  return Astro.redirect(
    `/auth/signin?next=${encodeURIComponent(Astro.url.pathname)}`,
  );
}
let canView = false;
let archiveUnavailable = false;
const role = Astro.locals.profile?.role;
const staff = isStaff(role);
let archive = {
  items: [],
  facets: { types: [], semesters: [], units: [], lessons: [] },
} as Awaited<ReturnType<typeof loadArchiveForCourse>>;
try {
  canView = await canViewCourse(Astro.locals, COURSE);
  if (canView) archive = await loadArchiveForCourse(COURSE);
} catch (error) {
  if (!(error instanceof ArchiveServiceUnavailableError)) throw error;
  archiveUnavailable = true;
  Astro.response.status = 503;
}
const { items, facets } = archive;
---

<BaseLayout title="FIN 3610 — Archive">
  <div class="mx-auto max-w-3xl px-4 py-12">
    <p class="text-xs uppercase tracking-wide text-accent font-medium">
      FIN 3610
    </p>
    <h1 class="mt-1 text-3xl font-semibold tracking-tight">Course archive</h1>
    <p class="mt-3 text-ink-muted">
      Past exams and assignments and lecture notes from prior semesters. Filter
      by type, semester, unit, or lesson, or search by keyword.
    </p>

    {
      archiveUnavailable ? (
        <div
          role="alert"
          class="mt-8 rounded border border-amber-300 bg-amber-50 p-4 text-sm text-amber-950"
        >
          <p class="font-medium">
            The course archive is temporarily unavailable.
          </p>
          <p class="mt-1">
            Refresh in a moment. Your materials have not been removed.
          </p>
        </div>
      ) : !canView ? (
        <div
          role="status"
          class="mt-8 rounded border border-amber-300 bg-amber-50 p-4 text-sm"
        >
          <p class="font-medium">You're not enrolled in FIN 3610.</p>
          <p class="mt-1 text-ink-muted">
            The course archive is available to enrolled students. Ask your
            instructor to add you to the roster.
          </p>
        </div>
      ) : (
        <Fragment>
          {staff && (
            <p class="mt-6 rounded border border-accent/30 bg-accent/5 p-3 text-sm">
              <a
                href={`/instructor/archive?course=${COURSE}`}
                class="font-medium text-accent underline"
              >
                ＋ Manage this archive →
              </a>
              <span class="ml-2 text-ink-muted">
                Add or edit videos, exams, and assignments.
              </span>
            </p>
          )}
          <ArchiveBrowser client:load items={items} facets={facets} />
        </Fragment>
      )
    }
  </div>
</BaseLayout>
